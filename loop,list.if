class Solution(object):
    def kidsWithCandies(self, candies, extraCandies):
        """
        :type candies: List[int]
        :type extraCandies: int
        :rtype: List[bool]
        """
        greatest = max(candies)
        result = []

        for candy in candies:   #Take every candy number from candies, one at a time.
            if candy + extraCandies >= greatest:
                result.append(True)   #If the child can become the greatest → True
            else:
                result.append(False)  #Otherwise → False

        return result
        
