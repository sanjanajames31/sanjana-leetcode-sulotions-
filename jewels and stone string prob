class Solution(object):                                                   #hashing problem
    def numJewelsInStones(self, jewels, stones):
        """
        :type jewels: str
        :type stones: str
        :rtype: int
        """
        dict={}
        for x in stones:
            if x in dict:
                dict[x]+=1
            else:
                dict[x]=1
        count = 0
        for x in jewels:
            if x in dict:
                count+=dict[x]
        return(count)
