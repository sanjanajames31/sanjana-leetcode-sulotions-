class Solution(object):
    def interpret(self, command):

        result = ""
        i = 0

        while i < len(command):

            # If we find "G"
            if command[i] == "G":
                result = result + "G"
                i = i + 1

            # If we find "()"
            elif command[i] == "(" and command[i + 1] == ")":
                result = result + "o"
                i = i + 2

            # If we find "(al)"
            elif command[i] == "(":
                result = result + "al"
                i = i + 4

        return result
