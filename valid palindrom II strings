class Solution(object):
    def validPalindrome(self, s):
        left = 0
        right = len(s) - 1
        while left < right:
            if s[left] != s[right]:
                # Remove left character
                a = s[:left] + s[left + 1:]
                # Remove right character
                b = s[:right]+s[right+1:]
                if a == a[::-1] or b == b[::-1]:
                    return True
                return False
            left += 1
            right -= 1
        return True
        
